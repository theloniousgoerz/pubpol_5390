binary_function = function(outcome,
training,
testing,
FS_recipe,
link
){
## SD Y ------------------------------
is_sd_y = sd(training[[outcome]])
os_sd_y = sd(testing[[outcome]])
## Define Model ------------------------------
glm = logistic_reg() %>%
set_engine("glm",
family = binomial(link = link))
## Define Workflow ------------------------------
glm_workflow =
workflow() %>%
add_model(glm) %>%
add_recipe(FS_recipe)
## Fit Model -------------------------------------
fit_glm =
glm_workflow %>%
fit(data = training)
## Obtain Predictions -----------------------------
glm_oos = predict(fit_glm,testing)
# Calculate RMSE ---------------------------------
## Combine Train-Test predictions and Outcomes into a DF
glm_gof_train_df = data.frame(
estimate = as.numeric(predict(fit_glm,training)$.pred),
truth = unlist(fit_glm$pre$mold$outcomes[[outcome]]))
glm_gof_test_df = data.frame(
estimate = as.numeric(glm_oos$.pred),
truth = as.numeric(testing[[outcome]]))
## Calculate RMSE ------------------------------
glm_train_rmse = rmse(
data = glm_gof_train_df,
truth,
estimate)
glm_test_rmse = rmse(
data = glm_gof_test_df,
truth,
estimate)
# Return Items ------------------------------
return(
data.frame(
Model = "OLS",
in_sample_sd_y = is_sd_y,
oo_sample_sd_y = os_sd_y,
in_sample_rmse = glm_train_rmse$.estimate,
oo_sample_rmse = glm_test_rmse$.estimate,
n_predictors = ncol(fit_glm$pre$mold$predictors)
)
)
}
