data_a = read_csv("../Data/births_for_class_A.csv")
data_b = read_csv("../Data/births_for_class_B.csv")
data_c = read_csv("../Data/births_for_class_C.csv")
data_d = read_csv("../Data/births_for_class_D.csv")
data_b %>% summarise(sd(birth_weight))
data_c %>% summarise(sd(birth_weight))
y_b = data_b$birth_weight
x_b <- data.matrix(data_b[, c('gestation_weeks',
"month",
"dayofweek",
"time",
"in_hospital",
"mom_age",
"mom_nativity",
"mom_race_hispanic_status",
"mom_marital_status",
"mom_educ",
"mom_height_inches",
"mom_bmi",
"residence_status",
"dad_age" )])
y_c = data_c$birth_weight
x_c <- data.matrix(data_c[, c('gestation_weeks',
"month",
"dayofweek",
"time",
"in_hospital",
"mom_age",
"mom_nativity",
"mom_race_hispanic_status",
"mom_marital_status",
"mom_educ",
"mom_height_inches",
"mom_bmi",
"residence_status",
"dad_age" )])
# OLS
ols_b = lm(y_b~x_b)
ols_c = lm(y_c~x_c)
# RMSE OLS
data_b$ols_y_pred = fitted(ols_b)
data_c$ols_y_pred = fitted(ols_c)
#perform k-fold cross-validation to find optimal lambda value
#cv_model <- cv.glmnet(x_b, y, alpha = 1)
#find optimal lambda value that minimizes test MSE
#best_lambda <- cv_model$lambda.min
#best_lambda
best_model <- glmnet(x_b, y_b, alpha = 1, lambda = 100)
# LASSO RMSE
data_b$y_pred_ls = predict(best_model, s=5, newx = x_b)
data_c$y_pred_ls = predict(best_model, s=5, newx = x_c)
data_b %>%
summarise(
niave = 1/nrow(data_b),
corrected = 1/(nrow(data_b) - 16),
RMSE_os = sqrt(sum((birth_weight - ols_y_pred)^2) * niave),
RMSE_is = sqrt(sum((birth_weight - ols_y_pred)^2) * corrected),
