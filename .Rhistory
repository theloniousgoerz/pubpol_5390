bw_recipe =
recipe(LBW ~ ., data = G)
bw_recipe_oos =
recipe(LBW ~ ., data = H)
# workflow
wflow =
workflow() %>%
add_model(binary) %>%
add_recipe(bw_recipe)
# Fit Model
fit_probit =
wflow %>%
fit(data = G)
