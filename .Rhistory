library(tidymodels)
library(readr)
library(tidyverse)
library(magrittr)
g = read_csv("../Data/births_for_class_Gsmall.csv")
h = read_csv("../Data/births_for_class_H.csv")
g %<>% mutate(label = "G")
h %<>% mutate(label = "H")
c = rbind(g,h)
g$birth_weight
## Create LHS ##
c %<>%
mutate(LBW = factor(ifelse(birth_weight < 2500,"low","normal"))) %>%
mutate(across(c(gestation_weeks,in_hospital,mom_educ,residence_status), as.factor))
G = c[c$label == "G",] %>% select(-label)
H = c[c$label == "H",] %>% select(-label) %>% filter(gestation_weeks %in% G$gestation_weeks)
binary = logistic_reg() %>%
set_engine("glm", family = binomial(link = "probit"))
bw_recipe =
recipe(LBW ~ ., data = G)
bw_recipe_oos =
recipe(LBW ~ ., data = H)
# workflow
wflow =
workflow() %>%
add_model(binary) %>%
add_recipe(bw_recipe)
# Fit Model
fit_probit =
wflow %>%
fit(data = G)
# fit on OOS #
wflow_oos =
workflow() %>%
add_model(binary) %>%
add_recipe(bw_recipe_oos)
fit_oos =
wflow_oos %>%
fit(data = H)
G$y_hat_probit_is = predict(fit_probit,new_data = G)$.pred
G$y_hat_probit_os = predict(fit_oos,new_data = H)$.pred
augment(fit_probit, new_data = H) |>
conf_mat(truth = fit_probit, estimate = .pred_class)
augment(G$y_hat_probit_is, new_data = H) |>
conf_mat(truth = fit_probit, estimate = .pred_class)
augment(G$y_hat_probit_is, new_data = H) |>
conf_mat(truth = Gy_hat_probit_is, estimate = .pred_class)
augment(G$y_hat_probit_is, new_data = H) |>
conf_mat(truth = G$y_hat_probit_is, estimate = .pred_class)
augment(G, new_data = H) |>
conf_mat(truth = G$y_hat_probit_is, estimate = .pred_class)
augment(fit_probit, new_data = H) |>
conf_mat(truth = G$y_hat_probit_is, estimate = .pred_class)
augment(fit_probit$fit, new_data = H) |>
conf_mat(truth = G$y_hat_probit_is, estimate = .pred_class)
augment(fit_probit, new_data = H) |>
conf_mat(truth = LBW, estimate = .pred_class)
augment(fit_probit, new_data = G) |>
conf_mat(truth = LBW, estimate = .pred_class)
augment(fit_probit, new_data = H) |>
conf_mat(truth = LBW, estimate = .pred_class)
