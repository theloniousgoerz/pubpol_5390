library(tidymodels)
library(here)
library(readr)
G = read_csv(here("Data","births_for_class_G.csv"))
H= read_csv(here("Data","births_for_class_H.csv"))
d = rbind(G,H)
set.seed(109900)
d = d %>% select(-gestation_weeks)
t = initial_split(d, prop = 3/4)
train = training(t)
test = testing(t)
tree_rec <-
recipe(birth_weight ~., data = train)
tree_prep <- prep(tree_rec)
juiced <- juice(tree_prep)
tune_spec <- rand_forest(
mtry = tune(),
trees = 100,
min_n = 10
) %>%
set_mode("regression") %>%
set_engine("ranger")
tune_wf <- workflow() %>%
add_recipe(tree_rec) %>%
add_model(tune_spec)
set.seed(234)
trees_folds <- vfold_cv(train,v = 10)
param_grid <- grid_regular(mtry(range = c(0, 10)), levels = 10)
doParallel::registerDoParallel()
tune_res <- tune_grid(
tune_wf,
resamples = trees_folds,
grid = param_grid
)
best_complexity <- select_best(tune_res, metric = "rmse")
rand_forest_final <- finalize_workflow(reg_tree_wf, best_complexity)
rand_forest_final <- finalize_workflow(tune_wf, best_complexity)
rf_fit <- fit(rand_forest_final, data = train)
rf_fit
rf_fit %>%
extract_fit_engine() %>%
rpart.plot()
pred = predict(rf_fit, new_data = test)
pred
rmse(truth = test$birth_weight,estimate = pred$.pred)
rmse(truth = test$birth_weight,estimate = as.numeric(pred$.pred))
rmse(truth = as.numeric(test$birth_weight),estimate = as.numeric(pred$.pred))
test$pred = pred$.pred
rmse(data = test,
truth = birth_weight,
estimate = pred)
sqrt(266206.1)
