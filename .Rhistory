library(tidymodels)
library(here)
library(readr)
library(vip)
library(tictoc)
library(ranger)
library(solitude)
G = read_csv(here("Data","births_for_class_G.csv"))
H= read_csv(here("Data","births_for_class_H.csv"))
d = rbind(G,H)
set.seed(109900)
d = d %>% select(-gestation_weeks)
t = initial_split(d, prop = 3/4)
train = training(t)
test = testing(t)
tree_rec <-
recipe(birth_weight ~., data = train)
tree_prep <- prep(tree_rec)
juiced <- juice(tree_prep)
tune_spec <- rand_forest(
mtry = tune(),
trees = 100,
min_n = 100
) %>%
set_mode("regression") %>%
set_engine("ranger",
importance = "impurity"
)
tune_wf <- workflow() %>%
add_recipe(tree_rec) %>%
add_model(tune_spec)
tic()
set.seed(234)
trees_folds <- vfold_cv(train,v = 5)
param_grid <- grid_regular(mtry(range = c(0, 10)), levels = 5)
doParallel::registerDoParallel()
tune_res <- tune_grid(
tune_wf,
resamples = trees_folds,
grid = param_grid
)
toc()
collect_metrics(tune_res)
best_complexity <- select_best(tune_res, metric = "rmse")
rand_forest_final <- finalize_workflow(tune_wf, best_complexity)
rf_fit <- fit(rand_forest_final, data = train)
train_gof = data.frame(
truth = as.numeric(rf_fit$pre$mold$outcomes$birth_weight),
estimate = as.numeric(predict(rf_fit,train)$.pred))
rmse(data = train_gof,
truth = truth,
estimate = estimate)
rf_fit
sqrt(261308.5)
rmse(data = train_gof,
truth = truth,
estimate = estimate)
pred = predict(rf_fit, new_data = test)
test$pred = pred$.pred
rmse(data = test,
truth = birth_weight,
estimate = pred)
# variable importance
rf_fit %>%
extract_fit_parsnip() %>%
vip(num_features = 10)
ranger_obj <- rf_fit %>%
extract_fit_engine()
ranger_obj <- rf_fit %>% extract_fit_engine()
terminalNodesDepth(ranger_obj) %>%
summarise(max(depth),
mean(depth))
