library(tidymodels)
library(here)
library(readr)
library(vip)
library(tictoc)
library(ranger)
G = read_csv(here("Data","births_for_class_G.csv"))
H= read_csv(here("Data","births_for_class_H.csv"))
d = rbind(G,H)
set.seed(109900)
d = d %>% select(-gestation_weeks)
t = initial_split(d, prop = 3/4)
train = training(t)
test = testing(t)
tree_rec <-
recipe(birth_weight ~., data = train)
tree_prep <- prep(tree_rec)
juiced <- juice(tree_prep)
tune_spec <- rand_forest(
mtry = tune(),
trees = 20,
min_n = 10
) %>%
set_mode("regression") %>%
set_engine("ranger",
importance = "impurity"
)
tune_wf <- workflow() %>%
add_recipe(tree_rec) %>%
add_model(tune_spec)
tic()
set.seed(234)
trees_folds <- vfold_cv(train,v = 5)
param_grid <- grid_regular(mtry(range = c(0, 10)), levels = 5)
doParallel::registerDoParallel()
tune_res <- tune_grid(
tune_wf,
resamples = trees_folds,
grid = param_grid
)
toc()
collect_metrics(tune_res)
best_complexity <- select_best(tune_res, metric = "rmse")
rand_forest_final <- finalize_workflow(tune_wf, best_complexity)
rf_fit <- fit(rand_forest_final, data = train)
rf_fit$fit$fit$
rf_fit %>%
extract_fit_parsnip() %>%
vip(num_features = 10)
ranger_obj <- rf_fit %>%
extract_fit_engine()
ranger_obj <- rf_fit %>% extract_fit_engine()
get_tree_depth <- function(tree_index,ob) {
require(magrittr)
depths = data.frame()
for (i in 1:tree_index ){
t = treeInfo(ob,tree= i)
t %<>%
summarise(m = max(splitvarID,na.rm = T))
depths[i,"id"] = i
depths[i,"depth"] = as.numeric(t$m)
}
return(max(depths$depth))
}
get_tree_depth(tree_index = ranger_obj$num.trees,ranger_obj)
ranger_obj
treeInfo(ranger_obj)
treeInfo(ranger_obj) %>% distinct(nodeID)
treeInfo(ranger_obj) %>% group_by(nodeID) %>% summarise(n())
treeInfo(ranger_obj)
treeInfo(ranger_obj) %>% group_by(nodeID) %>% summarise(max(rightChild))
treeInfo(ranger_obj) %>%
summarise(max(rightChild))
treeInfo(ranger_obj) %>%
summarise(max(rightChild,na.rm = T))
treeInfo(ranger_obj)
treeInfo(ranger_obj) %>%
summarise(sum(terminal))
treeInfo(ranger_obj) %>%
filter(!is.na(prediction))
treeInfo(ranger_obj) %>%
filter(!is.na(prediction)) %>%
summarise(sum(terminal))
treeInfo(ranger_obj)$depth %>%
