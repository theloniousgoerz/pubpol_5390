shape = `Feature Set`)) +
geom_point(
position = position_dodge(width = 0.4),
size = 5
) +
geom_hline(yintercept = 0,
color = "grey50",
lwd = 1,
linetype = "dashed") +
annotate("text",
x = 4.5,
y = -1,
label = "Baseline Logit",
size = 4, color = "grey50") +
theme_cowplot() +
theme(legend.position = "bottom")
ggsave(survive_improvement,
filename = here("Final","Images","survive_improvement_rel.jpeg"),
width = 9,
height = 5)
