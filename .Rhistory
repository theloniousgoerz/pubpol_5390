treeInfo(ranger_obj)$depth
install.packages("solitude")
library(solitude)
get_tree_depth <- function(tree_index,ob) {
require(magrittr)
require(solitude)
depths = data.frame()
for (i in 1:tree_index ){
t = treeInfo(ob,tree= i)
t %<>% terminalNodesDepth(t)
depths[i,"id"] = i
depths[i,"depth"] = as.numeric(t$m)
}
return(max(depths$depth))
}
