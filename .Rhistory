library(tidymodels)
library(readr)
library(tidyverse)
library(magrittr)
g = read_csv("../Data/births_for_class_Gsmall.csv")
h = read_csv("../Data/births_for_class_H.csv")
g %<>% mutate(label = "G")
h %<>% mutate(label = "H")
c = rbind(g,h)
## Create LHS ##
c %<>%
mutate(LBW = factor(ifelse(birth_weight < 2500,1,0))) %>%
mutate(across(c(gestation_weeks,mom_age,in_hospital,mom_educ,residence_status,mom_height_inches), as.factor))
G = c[c$label == "G",]
H = c[c$label == "H",]
binary = logistic_reg() %>%
set_engine("glm", family = binomial(link = "probit"))
bw_recipe =
recipe(LBW ~ ., data = G)
bw_recipe_oos =
recipe(LBW ~ ., data = H)
# workflow
wflow =
workflow() %>%
add_model(binary) %>%
add_recipe(bw_recipe)
# Fit Model
fit_probit =
wflow %>%
fit(data = G)
