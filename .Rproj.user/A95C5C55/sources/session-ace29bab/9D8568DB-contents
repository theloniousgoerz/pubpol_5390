\subsection{In and Out-of-Sample Goodness of Fit}

```{r Q1: In-out-sample}
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# Calculate GOF

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

# Get predicted values (In-Sample)
ols_set1_is = fitted(ols_set1)
ols_set2_is = fitted(ols_set2)
ols_set3_is = fitted(ols_set3)

# Get predicted values (Out-of-Sample)
ols_set1_os = predict(ols_set1,newdata = BW_test)
ols_set2_os = predict(ols_set2,newdata = BW_test)
ols_set3_os = predict(ols_set3,newdata = BW_test)

# Append to Datasets
BW_train$y_hat_set1 = ols_set1_is
BW_train$y_hat_set2 = ols_set2_is
BW_train$y_hat_set3 = ols_set3_is

BW_test$y_hat_set1 = ols_set1_os
BW_test$y_hat_set2 = ols_set2_os
BW_test$y_hat_set3 = ols_set3_os



# Train GOF # 
df_train = BW_train %>% 
 summarise(
    `Sample` = "E",
    `SD Birthweight` = sd(birth_weight),
    `N Features Set 1` = 9,
    `RMSE Feature Set 1` = sqrt(sum((birth_weight - y_hat_set1)^2) * 1/(nrow(BW_train) - 10)),
    `R-squared Set 1` = summary(ols_set1)$r.squared,
    `N Features Set 2` = 37,
    `RMSE Feature Set 2` = sqrt(sum((birth_weight - y_hat_set2)^2) * 1/(nrow(BW_train) - 38)),
    `R-squared Set 2` = summary(ols_set2)$r.squared,
    `N Features Set 3` = 164,
    `RMSE Feature Set 3` = sqrt(sum((birth_weight - y_hat_set3)^2) * 1/(nrow(BW_train) - 165)),
    `R-squared Set 3` = summary(ols_set3)$r.squared,
   )

# Test GOF

df_test = BW_test %>% 
 summarise(
    `Sample` = "F",
    `SD Birthweight` = sd(birth_weight),
    `N Features Set 1` = 9,
    `RMSE Feature Set 1` = sqrt(sum((birth_weight - y_hat_set1)^2) * 1/(nrow(BW_test))),
    
    `R-squared Set 1` = 1- sum((birth_weight - y_hat_set1)^2) / sum((birth_weight - mean(birth_weight))^2),
    
    `N Features Set 2` = 37,
